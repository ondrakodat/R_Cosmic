x <- orbital_data$OrbPay
prumer_x <- mean(x)
sd_pop <- sqrt(mean((x - prumer_x)^2))
popisna_OrbPay <- data.frame(
  Pocet = length(x),
  Minimum = min(x),
  Maximum = max(x),
  Prumer = prumer_x,
  Median = median(x),
  Rozptyl = var(x),
  Smerodatna_odchylka = sd(x),
  Sikmost = mean((x - prumer_x)^3) / sd_pop^3,
  Spicatost_exces = mean((x - prumer_x)^4) / sd_pop^4 - 3
)
round(popisna_OrbPay, 4)
¨
orbital_data$Obdobi <- ifelse(
  orbital_data$Rok < 2000,
  "1957-1999",
  "2000-2026"
)
table(orbital_data$Obdobi)
# H0: průměrný OrbPay je v obou obdobích stejný
# H1: průměrný OrbPay se mezi obdobími liší
t.test(
  OrbPay ~ Obdobi,
  data = orbital_data,
  alternative = "two.sided",
  var.equal = FALSE,
  conf.level = 0.95
)
orbital_data$Desetileti <- factor(floor(orbital_data$Rok / 10) * 10)
table(orbital_data$Desetileti)
# H0: průměry OrbPay jsou ve všech desetiletích stejné
# H1: alespoň jedno desetiletí má jiný průměr
oneway.test(
  OrbPay ~ Desetileti,
  data = orbital_data,
  var.equal = FALSE
)
pairwise.t.test(
  orbital_data$OrbPay,
  orbital_data$Desetileti,
  p.adjust.method = "holm",
  pool.sd = FALSE
)
cor.test(
  orbital_data$Rok,
  orbital_data$OrbPay,
  method = "pearson"
)
cor.test(
  orbital_data$Rok,
  orbital_data$OrbPay,
  method = "spearman",
  exact = FALSE
)
model_linear <- lm(OrbPay ~ Rok, data = orbital_data)
summary(model_linear)
confint(model_linear)
orbital_data$Rok_c <- orbital_data$Rok - 2000
model_quad <- lm(
  OrbPay ~ Rok_c + I(Rok_c^2),
  data = orbital_data
)
summary(model_quad)
anova(model_linear, model_quad)
sloupce_kontroly <- c(
  "Apogee", "Perigee", "Inc", "Azimuth",
  "Range", "OrbMass", "OrbPay"
)
cisla_kontrola <- as.data.frame(lapply(
  orbital_data[sloupce_kontroly],
  function(z) {
    z <- trimws(as.character(z))
    z[z %in% c("", "-")] <- NA
    suppressWarnings(as.numeric(z))
  }
))
audit_cisel <- data.frame(
  Promenna = names(cisla_kontrola),
  Platnych = sapply(cisla_kontrola, function(z) sum(!is.na(z))),
  Chybejicich = sapply(cisla_kontrola, function(z) sum(is.na(z))),
  Minimum = sapply(
    cisla_kontrola,
    function(z) if (all(is.na(z))) NA else min(z, na.rm = TRUE)
  ),
  Maximum = sapply(
    cisla_kontrola,
    function(z) if (all(is.na(z))) NA else max(z, na.rm = TRUE)
  )
)
audit_cisel
summary(cisla_kontrola$Apogee)
summary(cisla_kontrola$Perigee)
summary(cisla_kontrola$Inc)
table(trimws(orbital_data$Apoflag), useNA = "ifany")
