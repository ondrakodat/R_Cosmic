  pocet_neorbitalnich_zaznamu = nrow(neorbitalni),
  prvni_rok = min(neorbitalni$Rok, na.rm = TRUE),
  posledni_rok = max(neorbitalni$Rok, na.rm = TRUE)
)
neorbitalni_rocne <- as.data.frame(table(neorbitalni$Rok))
names(neorbitalni_rocne) <- c("rok", "pocet_zaznamu")
neorbitalni_rocne$rok <- as.integer(as.character(neorbitalni_rocne$rok))
head(neorbitalni_rocne, 10)
tail(neorbitalni_rocne, 10)
table(prvni_kod[prvni_kod %in% c("D", "N", "X", "Z")])
promenne <- c(
  "OrbMass", "OrbPay", "Apogee", "Perigee",
  "Inc", "Azimuth", "Range"
)
preved_na_cislo <- function(z) {
  z <- trimws(as.character(z))
  z[z %in% c("", "-")] <- NA
  suppressWarnings(as.numeric(z))
}
cisla <- as.data.frame(lapply(naklad[promen­ne], preved_na_cislo))
names(cisla) <- promenne
audit_cisel <- data.frame(
  promenna = promenne,
  platne = sapply(cisla, function(z) sum(!is.na(z))),
  ruzne_hodnoty = sapply(cisla, function(z) length(unique(z[!is.na(z)]))),
  minimum = sapply(cisla, function(z) {
    if (all(is.na(z))) NA_real_ else min(z, na.rm = TRUE)
  }),
  maximum = sapply(cisla, function(z) {
    if (all(is.na(z))) NA_real_ else max(z, na.rm = TRUE)
  })
)
audit_cisel
table(trimws(naklad$Apoflag), useNA = "ifany")
cisla <- as.data.frame(lapply(naklad[promenne], preved_na_cislo))
names(cisla) <- promenne
audit_cisel <- data.frame(
  promenna = promenne,
  platne = sapply(cisla, function(z) sum(!is.na(z))),
  ruzne_hodnoty = sapply(cisla, function(z) length(unique(z[!is.na(z)]))),
  minimum = sapply(cisla, function(z) {
    if (all(is.na(z))) NA_real_ else min(z, na.rm = TRUE)
  }),
  maximum = sapply(cisla, function(z) {
    if (all(is.na(z))) NA_real_ else max(z, na.rm = TRUE)
  })
)
audit_cisel
flag_ap <- trimws(as.character(naklad$Apoflag))
flag_ap[is.na(flag_ap)] <- ""
naklad$Desetileti <- factor(floor(naklad$Rok / 10) * 10)
pokryti <- data.frame(
  Desetileti = naklad$Desetileti,
  OrbPay = as.integer(!is.na(cisla$OrbPay)),
  Apogee = as.integer(!is.na(cisla$Apogee) & flag_ap != "?"),
  Perigee = as.integer(!is.na(cisla$Perigee)),
  Inc = as.integer(!is.na(cisla$Inc))
)
pokryti_podle_desetileti <- aggregate(
  . ~ Desetileti,
  data = pokryti,
  FUN = sum
)
pokryti_podle_desetileti
flag_ap <- trimws(as.character(naklad$Apoflag))
flag_ap[is.na(flag_ap)] <- ""
analyzni_data <- data.frame(
  Desetileti = naklad$Desetileti,
  Apogee = ifelse(flag_ap == "?", NA_real_, cisla$Apogee),
  Perigee = cisla$Perigee,
  Inc = cisla$Inc
)
for (prom in c("Apogee", "Perigee", "Inc")) {
  d <- data.frame(
    hodnota = analyzni_data[[prom]],
    Desetileti = analyzni_data$Desetileti
  )
  d <- subset(
    d,
    !is.na(hodnota) &
      as.integer(as.character(Desetileti)) >= 1960
  )
  d$Desetileti <- droplevels(d$Desetileti)
  cat("\n", prom, "\n")
  print(table(d$Desetileti))
  print(oneway.test(hodnota ~ Desetileti, data = d, var.equal = FALSE))
  print(pairwise.t.test(
    d$hodnota,
    d$Desetileti,
    p.adjust.method = "holm",
    pool.sd = FALSE
  ))
}
souhrn_momenty <- do.call(rbind, lapply(
  c("Apogee", "Perigee", "Inc"),
  function(prom) {
    z <- analyzni_data[[prom]]
    z <- z[!is.na(z)]
    prumer <- mean(z)
    sd_pop <- sqrt(mean((z - prumer)^2))
    data.frame(
      promenna = prom,
      n = length(z),
      prumer = prumer,
      rozptyl = var(z),
      smerodatna_odchylka = sd(z),
      sikmost = mean((z - prumer)^3) / sd_pop^3,
      spicatost_exces = mean((z - prumer)^4) / sd_pop^4 - 3,
      minimum = min(z),
      maximum = max(z)
    )
  }
))
souhrn_momenty
q()
