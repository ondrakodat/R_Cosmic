naklad$Obdobi <- factor(
  ifelse(naklad$Rok < 2000, "1957-1999", "2000-2026"),
  levels = c("1957-1999", "2000-2026")
)
table(naklad$Obdobi)
aggregate(
  OrbPay_num ~ Obdobi,
  data = naklad,
  FUN = mean
)
aggregate(
  OrbPay_num ~ Obdobi,
  data = naklad,
  FUN = median
)
t.test(
  OrbPay_num ~ Obdobi,
  data = naklad,
  var.equal = FALSE,
  conf.level = 0.95
)
table(naklad_top5$typ_rakety)
anova_rakety <- oneway.test(
  OrbPay_num ~ typ_rakety,
  data = naklad_top5,
  var.equal = FALSE
)
anova_rakety
pary_rakety <- pairwise.t.test(
  naklad_top5$OrbPay_num,
  naklad_top5$typ_rakety,
  p.adjust.method = "holm",
  pool.sd = FALSE
)
pary_rakety
cor.test(
  pocet_rocne$rok,
  pocet_rocne$pocet_startu,
  method = "pearson"
)
cor.test(
  pocet_rocne$rok,
  pocet_rocne$pocet_startu,
  method = "spearman",
  exact = FALSE
)
pocet_rocne$rok_c <- pocet_rocne$rok - 2000
model_linear_pocet <- lm(
  pocet_startu ~ rok_c,
  data = pocet_rocne
)
model_quad_pocet <- lm(
  pocet_startu ~ rok_c + I(rok_c^2),
  data = pocet_rocne
)
summary(model_linear_pocet)
summary(model_quad_pocet)
anova(model_linear_pocet, model_quad_pocet)
png(
  "nova_analyza/regrese_rocniho_poctu_startu.png",
  width = 1800,
  height = 1000,
  res = 150
)
plot(
  pocet_rocne$rok,
  pocet_rocne$pocet_startu,
  pch = 16,
  col = "steelblue",
  xlab = "Rok",
  ylab = "Počet orbitálních startů",
  main = "Lineární a kvadratický trend ročních počtů",
  sub = "Rok 2026 je neúplný"
)
lines(
  pocet_rocne$rok,
  predict(model_linear_pocet),
  col = "firebrick",
  lwd = 2
)
lines(
  pocet_rocne$rok,
  predict(model_quad_pocet),
  col = "darkgreen",
  lwd = 2
)
legend(
  "topleft",
  legend = c("Lineární model", "Kvadratický model"),
  col = c("firebrick", "darkgreen"),
  lty = 1,
  lwd = 2,
  bty = "n"
)
dev.off()
